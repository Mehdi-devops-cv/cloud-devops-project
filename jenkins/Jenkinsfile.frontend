pipeline {
  agent any
  stages {
    stage('Checkout') {
      steps { checkout scm }
    }
    stage('Install') {
      steps { sh 'cd frontend && npm ci' }
    }
    stage('Build') {
      steps { sh 'cd frontend && VITE_API_URL=${VITE_API_URL} npm run build' }
    }
    stage('Sync S3') {
      steps { sh 'aws s3 sync frontend/dist s3://${S3_BUCKET}/ --delete' }
    }
    stage('CloudFront Invalidate') {
      steps { sh 'aws cloudfront create-invalidation --distribution-id ${CF_ID} --paths "/*"' }
    }
  }
}