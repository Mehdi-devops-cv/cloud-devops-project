pipeline {
    agent any
    
    environment {
        DOCKER_IMAGE = 'appbtp-backend'
        DOCKER_TAG = "${env.BUILD_NUMBER}"
        AWS_REGION = 'eu-west-3'
        // URL du registry ECR, definie comme variable globale Jenkins
        ECR_URL = "${env.ECR_URL}"
        MONGODB_URI = credentials('mongodb-uri')
        JWT_SECRET = credentials('jwt-secret')
    }
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        stage('Install Dependencies') {
            steps {
                dir('backend') {
                    sh 'npm ci'
                }
            }
        }
        
        stage('Run Tests') {
            steps {
                dir('backend') {
                    sh 'npm test'
                }
            }
            post {
                always {
                    junit 'backend/coverage/junit.xml'
                }
            }
        }
        
        stage('Build Docker Image') {
            steps {
                script {
                    sh "docker build -f docker/backend/Dockerfile -t ${DOCKER_IMAGE}:${DOCKER_TAG} ."
                    sh "docker tag ${DOCKER_IMAGE}:${DOCKER_TAG} ${DOCKER_IMAGE}:latest"
                }
            }
        }
        
        stage('Security Scan') {
            steps {
                script {
                    sh "docker run --rm -v /var/run/docker.sock:/var/run/docker.sock aquasec/trivy image ${DOCKER_IMAGE}:${DOCKER_TAG} || true"
                }
            }
        }
        
        stage('Push to ECR') {
            when {
                branch 'main'
            }
            steps {
                script {
                    sh """
                        aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${ECR_URL}
                        docker tag ${DOCKER_IMAGE}:${DOCKER_TAG} ${ECR_URL}:${DOCKER_TAG}
                        docker tag ${DOCKER_IMAGE}:${DOCKER_TAG} ${ECR_URL}:latest
                        docker push ${ECR_URL}:${DOCKER_TAG}
                        docker push ${ECR_URL}:latest
                    """
                }
            }
        }

        stage('Deploy to Kubernetes') {
            when {
                branch 'main'
            }
            steps {
                script {
                    sh "kubectl set image deployment/backend backend=${DOCKER_IMAGE}:${DOCKER_TAG} -n appbtp || true"
                    sh "kubectl rollout status deployment/backend -n appbtp --timeout=120s || true"
                }
            }
        }
    }
    
    post {
        success {
            echo 'Backend pipeline completed successfully!'
        }
        failure {
            echo 'Backend pipeline failed!'
        }
        cleanup {
            cleanWs()
        }
    }
}
