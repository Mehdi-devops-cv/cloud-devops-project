# Copier en .env (ignore par Git) et remplir.
#   cp .env.example .env

NODE_ENV=development
PORT=5000

# Base de donnees
MONGODB_URI=mongodb://appbtp:<password>@localhost:27017/appbtp?authSource=admin

# Auth
JWT_SECRET=<chaine-aleatoire-32-caracteres-minimum>

# Stockage images
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# File de messages (worker asynchrone)
RABBITMQ_URL=amqp://guest:guest@localhost:5672
WORKER_ENABLED=true

# Observabilite
LOG_LEVEL=info
PROMETHEUS_ENABLED=true
